{
  "name": "paradedb-demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "emit": "prisma-next contract emit",
    "db:init": "prisma-next db init",
    "db:drop": "tsx scripts/drop-db.ts",
    "seed": "tsx scripts/seed.ts",
    "start": "tsx src/main.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down -v",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings"
  },
  "dependencies": {
    "@prisma/orm-extension-paradedb": "workspace:0.16.0",
    "@prisma/orm-postgres": "workspace:0.16.0",
    "arktype": "^2.2.2",
    "dotenv": "^17.4.2",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@repo/test-utils": "workspace:0.16.0",
    "@repo/tsconfig": "workspace:0.16.0",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "version": "0.16.0"
}
