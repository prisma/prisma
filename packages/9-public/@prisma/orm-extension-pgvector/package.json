{
  "name": "@prisma/orm-extension-pgvector",
  "version": "0.16.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "pgvector embedding columns, distance operators, and indexes for Prisma Next",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "biome check . --error-on-warnings",
    "clean": "rm -rf dist src-gen",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/orm-family-sql": "workspace:0.16.0",
    "@prisma/orm-framework": "workspace:0.16.0",
    "@prisma/orm-target-postgres": "workspace:0.16.0",
    "@prisma/orm-toolchain": "workspace:0.16.0",
    "@standard-schema/spec": "^1.1.0",
    "arktype": "^2.2.2"
  },
  "devDependencies": {
    "@prisma-next/extension-pgvector": "workspace:0.16.0",
    "@prisma-next/tsconfig": "workspace:0.16.0",
    "@prisma-next/tsdown": "workspace:0.16.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "exports": {
    "./codec-types": "./dist/codec-types.mjs",
    "./column-types": "./dist/column-types.mjs",
    "./control": "./dist/control.mjs",
    "./operation-types": "./dist/operation-types.mjs",
    "./pack": "./dist/pack.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./package.json": "./package.json"
  }
}
