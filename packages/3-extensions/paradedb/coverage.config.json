{
  "include": ["src/**/*.ts"],
  "exclude": [
    "dist/**",
    "test/**",
    "**/*.test.ts",
    "**/*.test-d.ts",
    "**/*.config.ts",
    "**/exports/**",
    "**/types.ts",
    "src/contract.d.ts"
  ],
  "thresholds": {
    "lines": 95,
    "branches": 90,
    "functions": 95,
    "statements": 95
  }
}
