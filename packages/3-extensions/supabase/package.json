{
  "name": "@internal/extension-supabase",
  "private": true,
  "version": "0.16.0",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build:contract-space": "prisma-next contract emit",
    "contract:generate": "tsx scripts/generate-contract.ts",
    "emit": "prisma-next contract emit --config test/fixtures/example-app.config.ts && prisma-next contract emit --config test/fixtures/no-policy.config.ts && prisma-next contract emit --config test/fixtures/renamed-policy.config.ts",
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "lint:fix:unsafe": "biome check --write --unsafe .",
    "clean": "rm -rf dist dist-tsc dist-tsc-prod coverage .tmp-output"
  },
  "dependencies": {
    "@internal/adapter-postgres": "workspace:0.16.0",
    "@internal/contract": "workspace:0.16.0",
    "@internal/driver-postgres": "workspace:0.16.0",
    "@internal/postgres": "workspace:0.16.0",
    "@internal/sql-builder": "workspace:0.16.0",
    "@internal/sql-orm-client": "workspace:0.16.0",
    "@internal/target-postgres": "workspace:0.16.0",
    "jose": "^6",
    "pg": "catalog:",
    "@internal/contract-authoring": "workspace:0.16.0",
    "@internal/family-sql": "workspace:0.16.0",
    "@internal/framework-components": "workspace:0.16.0",
    "@internal/migration-tools": "workspace:0.16.0",
    "@internal/sql-contract": "workspace:0.16.0",
    "@internal/sql-contract-ts": "workspace:0.16.0",
    "@internal/sql-operations": "workspace:0.16.0",
    "@internal/sql-relational-core": "workspace:0.16.0",
    "@internal/sql-runtime": "workspace:0.16.0",
    "@internal/sql-schema-ir": "workspace:0.16.0",
    "@internal/utils": "workspace:0.16.0",
    "@standard-schema/spec": "^1.1.0",
    "@types/pg": "catalog:",
    "arktype": "^2.2.2"
  },
  "devDependencies": {
    "@internal/cli": "workspace:0.16.0",
    "ci-info": "^4.3.1",
    "@internal/operations": "workspace:0.16.0",
    "@internal/psl-printer": "workspace:0.16.0",
    "@internal/sql-contract-psl": "workspace:0.16.0",
    "@repo/test-utils": "workspace:0.16.0",
    "@repo/tsconfig": "workspace:0.16.0",
    "@repo/tsdown": "workspace:0.16.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@internal/adapter-postgres": "workspace:0.16.0",
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "@internal/adapter-postgres": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./pack": "./dist/pack.mjs",
    "./runtime": "./dist/runtime.mjs",
    "./contract": {
      "types": "./dist/contract.d.mts",
      "import": "./dist/contract.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prisma/prisma.git",
    "directory": "packages/3-extensions/supabase"
  }
}
