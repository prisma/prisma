    "@internal/framework-components": "workspace:8.0.0-rc.19",
    "@internal/sql-contract": "workspace:8.0.0-rc.19",
    "@internal/sql-contract-psl": "workspace:8.0.0-rc.19",
    "@internal/sql-contract-ts": "workspace:8.0.0-rc.19",
    "@internal/target-mysql": "workspace:8.0.0-rc.19",
    "@internal/utils": "workspace:8.0.0-rc.19",
    "pathe": "^2.0.3"
