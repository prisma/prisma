model Location {
  id               Int               @id
  name             String?
  companies        Company[]
  companyLocations CompanyLocation[]
}

model Company {
  id               Int               @id
  name             String?
  locations        Location[]
  companyLocations CompanyLocation[]
}

model CompanyLocation {
  companyId  Int
  locationId Int
  company    Company  @relation(fields: [companyId], references: [id])
  location   Location @relation(fields: [locationId], references: [id])

  @@id([companyId, locationId])
}
