model Parent {
  id Int @id
  children Child[]
}
model Child {
  childId Int @id
  parentId Int?
  parent Parent? @relation(fields: [parentId], references: [id])
  string String[]
  int Int[]
  bInt BigInt[]
  float Float[]
  bytes Bytes[]
  bool Boolean[]
  dt DateTime[]
  empty Int[]
  unset Int[]
}
